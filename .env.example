# Copie para .env e preencha. NUNCA versione o .env.
# Os dois segredos abaixo ficam vazios de propósito: o docker compose e a aplicação recusam subir sem eles.

# Senha do PostgreSQL. Gere com: openssl rand -hex 24
DB_PASSWORD=

# Segredo de assinatura do JWT, mínimo 32 bytes. Gere com: openssl rand -base64 48
JWT_SECRET=

CHECKING_OVERDRAFT_LIMIT=0.00

# Swagger UI e /v3/api-docs. Em produção real, deixe false.
SWAGGER_ENABLED=true
